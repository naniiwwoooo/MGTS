# ============================================================
#  Локальные настройки ИИ-модели (файл НЕ коммитится в git)
#  Заполните значения ниже. Пустой ключ = ИИ-анализ отключён.
#  Этот файл — шаблон. Скопируйте его в llm/.env и впишите реальный ключ.
# ============================================================

# Провайдер: GigaChat | OpenRouter (OpenAI-совместимые)
# Для GigaChat оставьте GigaChat.
LLM_PROVIDER=GigaChat

# Ключ авторизации GigaChat (Authorization key из личного кабинета Studio).
# Это готовый Base64-ключ (Client ID + Client Secret), а НЕ Client Secret.
# НИКОГДА не публикуйте и не коммитьте его.
LLM_API_KEY=your-authorization-key

# Название модели GigaChat. Актуальные ID:
#   GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max | GigaChat-3-Ultra
# (старые GigaChat / GigaChat-Pro больше не поддерживаются)
# Для физлиц во freemium-режиме доступна GigaChat-3-Ultra.
LLM_MODEL=GigaChat-2

# Базовый адрес GigaChat API
LLM_BASE_URL=https://api.giga.chat/v1

# Адрес получения токена доступа (OAuth)
LLM_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Область доступа: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_CORP (юрлица/ИП)
LLM_SCOPE=GIGACHAT_API_PERS

# Параметры генерации
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60

# При необходимости укажите PEM-файл доверенного CA для HTTPS.
# LLM_CA_FILE=/path/to/trusted-ca.pem
