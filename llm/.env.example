# ============================================================
#  Локальные настройки ИИ-модели (файл НЕ коммитится в git)
#  Заполните значения ниже. Пустой ключ = ИИ-анализ отключён.
#  Подробная инструкция: llm/README.md
# ============================================================

# Провайдер: openai | anthropic
# Для OpenAI-совместимых сервисов (OpenRouter, Ollama и др.) оставьте openai
# и при необходимости укажите свой LLM_BASE_URL.
LLM_PROVIDER=OpenRouter

# Ключ доступа. НИКОГДА не публикуйте и не коммитьте его.
LLM_API_KEY=test-api-key

# Название модели (примеры: gpt-4o-mini, claude-3-5-sonnet-latest)
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Базовый адрес API. Для OpenRouter: https://openrouter.ai/api/v1
# Для локальной Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Параметры генерации
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60
